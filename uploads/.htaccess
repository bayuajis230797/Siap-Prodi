# Allow access to image files and documents (compatible with Apache 2.2 and 2.4)
<FilesMatch "\.(jpg|jpeg|png|gif|bmp|webp|svg|pdf|doc|docx|xls|xlsx)$">
    <IfModule mod_authz_core.c>
        # Apache 2.4+
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Deny access to PHP and script files for security
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        # Apache 2.4+
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        # Apache 2.2
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
















