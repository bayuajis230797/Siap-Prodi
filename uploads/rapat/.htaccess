Options -Indexes

# Izinkan file gambar/dokumen (upload tetap via PHP; ini hanya akses baca HTTP)
<FilesMatch "\.(jpg|jpeg|png|gif|bmp|webp|pdf)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>

# Blokir eksekusi skrip di folder upload
<FilesMatch "\.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
